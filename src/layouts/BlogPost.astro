---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE } from '../site_config';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<!doctype html>
<html lang={SITE.lang} dir={SITE.dir}>
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
	</head>

	<body>
		<Header />
		<main class="!m-0 !w-full !max-w-full !bg-[#fffaf3] !p-0">
			<article class="pb-16">
				<div class="w-full">
					{
						heroImage && (
							<div class="mx-auto aspect-[16/9] w-full max-w-[1020px] overflow-hidden shadow-[var(--box-shadow)]">
								<Image
									width={1024}
									height={576}
									src={heroImage}
									alt=""
									class="block h-full w-full rounded-none object-cover"
								/>
							</div>
						)
					}
				</div>

				<div
					class="prose relative z-[1] mx-auto max-w-[calc(100%_-_2em)] p-4"
				>
					<header class="mb-4 py-4 text-center leading-none">
						<div class="mb-2 text-[rgb(var(--gray))]">
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<div class="italic">
										Last updated on <FormattedDate date={updatedDate} />
									</div>
								)
							}
						</div>
						<h1 class="!mb-2 !text-[3.052em]">{title}</h1>
						<hr />
						{
							description && (
								<aside
									class="post-description-note mx-auto mt-8 max-w-[calc(100%_-_2em)] px-5 py-4 text-left sm:max-w-[720px] sm:px-6 sm:py-5"
									aria-label="Post description"
								>
									<p class="m-0">{description}</p>
								</aside>
							)
						}
					</header>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
		<script>
			import '../scripts/typography';
		</script>
	</body>
</html>

<style>
	.post-description-note {
		border-left: 4px solid #fe9600;
		background: linear-gradient(90deg, color-mix(in srgb, #fe9600 10%, transparent), transparent 72%);
		color: color-mix(in srgb, rgb(var(--gray-dark)) 84%, #7b4a2a);
		font-family: var(--font-markdown-quote);
		font-size: 1.05em;
		font-size-adjust: 0.45;
		font-style: normal;
		line-height: 1.75;
	}

	.post-description-note p {
		margin: 0;
	}
</style>
