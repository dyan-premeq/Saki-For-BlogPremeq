---
import type { ImageMetadata } from "astro";
import { Font } from "astro:assets";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE } from "../config/site";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata | string;
  bodyClass?: string;
}

const { title, description, image, bodyClass } = Astro.props;

const zeoSevenFontLinks = [
  "https://fontsapi.zeoseven.com/24/main/result.css",
  "https://fontsapi.zeoseven.com/292/main/result.css",
]
  .map(
    (href) =>
      `<link href="${href}" onload="this.onload=null;this.rel='stylesheet'" rel="preload" as="style" crossorigin /><noscript><link rel="stylesheet" href="${href}" /></noscript>`,
  )
  .join("");
---

<!doctype html>
<html lang={SITE.lang} dir={SITE.dir}>
  <head>
    <BaseHead title={title} description={description} image={image} />

    <Font
      cssVariable="--font-atkinson"
      preload={[{ weight: 400, style: "normal" }]}
    />
    <Font cssVariable="--font-cascadia-code" />
    <Font cssVariable="--font-jetbrains-mono" />
    <Font cssVariable="--font-syne" />
    <Font cssVariable="--font-tangerine" />
    <Font cssVariable="--font-liberation-serif" />

    <Fragment set:html={zeoSevenFontLinks} />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
