---
import { SITE } from '../site_config';

const today = new Date();
---

<footer class="site-footer">
	<p class="footer-title">{SITE.title}</p>
	<p class="footer-copy">
		&copy; {today.getFullYear()} Dyan Premeq. Built with <a href="https://astro.build/">Astro</a>.
	</p>
	<nav class="footer-links" aria-label="Footer navigation">
		<a href="/blog/">Archive</a>
		<a href="/about/">About</a>
		<a href="/rss.xml">RSS</a>
	</nav>
</footer>

<style>
	.site-footer {
		padding: 48px 18px 76px;
		border-top: 1px solid rgba(0, 0, 0, 0.06);
		background:
			linear-gradient(180deg, #fff, rgba(255, 250, 243, 0.94)),
			repeating-linear-gradient(90deg, rgba(254, 150, 0, 0.05) 0 1px, transparent 1px 92px);
		color: rgba(0, 0, 0, 0.48);
		text-align: center;
	}

	.footer-title {
		margin: 0 0 8px;
		color: #333;
		font-family: Georgia, 'Times New Roman', serif;
		font-size: 24px;
		letter-spacing: -0.04em;
	}

	.footer-copy {
		margin: 0;
		font-size: 14px;
	}

	.footer-links {
		display: flex;
		justify-content: center;
		gap: 22px;
		margin-top: 18px;
	}

	.footer-links a {
		position: relative;
		color: rgba(0, 0, 0, 0.58);
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.footer-links a::after {
		position: absolute;
		right: 0;
		bottom: -4px;
		left: 0;
		height: 1px;
		background: #fe9600;
		content: '';
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.2s ease;
	}

	.footer-links a:hover::after {
		transform: scaleX(1);
	}

	@media (max-width: 560px) {
		.footer-links {
			gap: 16px;
		}
	}
</style>
