---
import IconBilibili from "../assets/icons/IconBilibili.svg";
import IconBrandX from "../assets/icons/IconBrandX.svg";
import IconGitHub from "../assets/icons/IconGitHub.svg";
import IconMail from "../assets/icons/IconMail.svg";
import IconRss from "../assets/icons/IconRss.svg";
import IconZhihu from "../assets/icons/IconZhihu.svg";
import { SITE, type SiteConfig } from "../config/site";

type SocialIcon = NonNullable<SiteConfig["socials"][number]["icon"]>;

const socialIcons = {
  mail: IconMail,
  github: IconGitHub,
  x: IconBrandX,
  zhihu: IconZhihu,
  bilibili: IconBilibili,
  rss: IconRss,
} satisfies Record<SocialIcon, typeof IconMail>;

const socialLinks = SITE.socials.map((social) => ({
  ...social,
  Icon: social.icon ? socialIcons[social.icon] : undefined,
}));

const today = new Date();
---

<footer class="site-footer">
  <img
    class="footer-avatar"
    src={SITE.avatar.src}
    alt={SITE.avatar.alt}
    width="64"
    height="64"
    loading="lazy"
  />
  <p class="footer-title font-display">{SITE.title}</p>
  <p class="footer-copy">
    &copy; {today.getFullYear()}
    {SITE.author}. Built with <a href="https://astro.build/">Astro</a>.
  </p>
  <nav class="footer-links" aria-label="Footer navigation">
    <a href="/post/">Archive</a>
    <a href="/about/">About</a>
    <a href="/rss.xml">RSS</a>
    {
      socialLinks.map(({ Icon, ...social }) => (
        <a href={social.href} title={social.linkTitle} rel="me">
          {Icon && (
            <Icon
              class="footer-social-icon"
              aria-hidden="true"
              focusable="false"
            />
          )}
          <span>{social.name}</span>
        </a>
      ))
    }
  </nav>
</footer>

<style>
  .site-footer {
    padding: 48px 18px 76px;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
    background:
      linear-gradient(180deg, #fff, rgba(255, 250, 243, 0.94)),
      repeating-linear-gradient(
        90deg,
        rgba(254, 150, 0, 0.05) 0 1px,
        transparent 1px 92px
      );
    color: rgba(0, 0, 0, 0.48);
    text-align: center;
  }

  .footer-avatar {
    display: block;
    width: 64px;
    height: 64px;
    margin: 0 auto 14px;
    border: 2px solid rgba(254, 150, 0, 0.32);
    border-radius: 999px;
    object-fit: cover;
  }

  .footer-title {
    margin: 0 0 8px;
    color: #333;
    font-size: 24px;
    letter-spacing: -0.04em;
  }

  .footer-copy {
    margin: 0;
    font-size: 14px;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 22px;
    margin-top: 18px;
  }

  .footer-links a {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: rgba(0, 0, 0, 0.58);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-decoration: none;
    text-transform: uppercase;
  }

  :global(.footer-social-icon) {
    width: 1.15em;
    height: 1.15em;
    flex: none;
  }

  .footer-links a::after {
    position: absolute;
    right: 0;
    bottom: -4px;
    left: 0;
    height: 1px;
    background: var(--color-accent);
    content: "";
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease;
  }

  .footer-links a:hover::after {
    transform: scaleX(1);
  }

  @media (max-width: 560px) {
    .footer-links {
      gap: 16px;
    }
  }
</style>
