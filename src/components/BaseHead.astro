---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { Font, getImage } from 'astro:assets';
import { SITE } from '../site_config';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata | string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? SITE.website);

const { title, description, image = SITE.homeHero } = Astro.props;
const imageSource =
	typeof image === 'string'
		? image
		: (await getImage({ src: image, width: Math.min(image.width, 1200) })).src;
const imageURL = new URL(imageSource, Astro.site ?? SITE.website);

const zeoSevenFontLinks = [
	'https://fontsapi.zeoseven.com/24/main/result.css',
	'https://fontsapi.zeoseven.com/292/main/result.css',
	'https://fontsapi.zeoseven.com/802/main/result.css',
]
	.map(
		(href) =>
			`<link href="${href}" onload="this.onload=null;this.rel='stylesheet'" rel="preload" as="style" crossorigin /><noscript><link rel="stylesheet" href="${href}" /></noscript>`,
	)
	.join('');
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE.title}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<Font cssVariable="--font-atkinson" preload />
<Font cssVariable="--font-cascadia-code" />
<Font cssVariable="--font-jetbrains-mono" />
<Font cssVariable="--font-syne" preload />
<Font cssVariable="--font-tangerine" />
<Font cssVariable="--font-liberation-serif" preload />

<Fragment set:html={zeoSevenFontLinks} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content={SITE.author} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={imageURL} />
