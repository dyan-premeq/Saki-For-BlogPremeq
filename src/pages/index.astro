---
import { Image } from "astro:assets";
import HomeHero from "../components/HomeHero.astro";
import RecentPosts from "../components/RecentPosts.astro";
import FeatureFallbackOne from "../assets/blog-placeholder-1.jpg";
import FeatureFallbackTwo from "../assets/blog-placeholder-2.jpg";
import FeatureFallbackThree from "../assets/blog-placeholder-4.jpg";
import { SITE } from "../config/site";
import SiteLayout from "../layouts/SiteLayout.astro";
import { getPostSlug, getVisiblePosts } from "../utils/content";

const posts = await getVisiblePosts();

const fallbackImages = [
  FeatureFallbackOne,
  FeatureFallbackTwo,
  FeatureFallbackThree,
];
const heroPost = posts[0];
const heroHref = heroPost ? `/post/${getPostSlug(heroPost)}/` : "/post/";

const featureCards = posts
  .filter((post) => post.data.isFeatured)
  .slice(0, 3)
  .map((post, index) => ({
    title: post.data.title,
    description: post.data.description,
    href: `/post/${getPostSlug(post)}/`,
    image: post.data.heroImage ?? fallbackImages[index % fallbackImages.length],
    label: index === 0 ? "Focus" : `0${index + 1}`,
  }));

const discoveryCards = posts.slice(0, 5).map((post, index) => ({
  title: post.data.title,
  description: post.data.description,
  href: `/post/${getPostSlug(post)}/`,
  image: post.data.heroImage ?? fallbackImages[index % fallbackImages.length],
  date: post.data.pubDate,
  index,
}));
---

<SiteLayout
  title={SITE.title}
  description={SITE.description}
  bodyClass="saki-home"
>
  <main class="saki-home-base">
    <HomeHero
      latestHref={heroHref}
      latestTitle={heroPost?.data.title ?? "Start reading"}
    />

    <div class="home-content">
      <section class="notice" aria-label="Site notice">
        <span class="notice-mark" aria-hidden="true">*</span>
        <p>
          {SITE.notice}
        </p>
      </section>

      <section class="feature-section" aria-labelledby="feature-title">
        <div class="section-heading">
          <p>Top Feature</p>
          <h2 id="feature-title" class="font-display">Focus</h2>
        </div>
        <div class="feature-grid">
          {
            featureCards.map((item) => (
              <a class="feature-card" href={item.href}>
                <Image
                  src={item.image}
                  alt=""
                  width={640}
                  height={360}
                  widths={[320, 480, 640, 800]}
                  sizes="(max-width: 860px) calc(100vw - 28px), (max-width: 996px) calc(33vw - 18px), 315px"
                  loading="lazy"
                  decoding="async"
                />
                <span class="feature-label">{item.label}</span>
                <span class="feature-title">
                  <strong>{item.title}</strong>
                  <small>{item.description}</small>
                </span>
              </a>
            ))
          }
        </div>
      </section>

      <RecentPosts posts={discoveryCards} />
    </div>
  </main>
</SiteLayout>

<style>
  :global(body.saki-home) {
    --background: 255 255 255;
    --middle-background: 255 250 243;
    background: rgb(var(--background));
    color: #353535;
  }

  :global(body.saki-home .site-footer) {
    position: relative;
    z-index: 20;
  }
  .saki-home-base {
    background: rgb(var(--background));
    overflow: clip;
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
  }

  .home-content {
    position: relative;
    z-index: 10;
    margin-top: 0;
    margin-bottom: 0;
    padding-top: 54px;
    padding-bottom: 72px;
    background-color: rgb(var(--middle-background));
    background-image: repeating-linear-gradient(
      90deg,
      rgba(254, 150, 0, 0.035) 0 1px,
      transparent 1px 96px
    );
  }

  .notice,
  .feature-section {
    width: min(var(--width-content), calc(100% - 36px));
    margin-right: auto;
    margin-left: auto;
  }

  .notice {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 0;
    padding: 18px 20px;
    border: 1px dashed rgba(40, 40, 40, 0.18);
    background: rgba(255, 255, 255, 0.72);
    color: rgba(30, 30, 30, 0.65);
    font-size: 15px;
    line-height: 1.7;
  }

  .notice p {
    margin: 0;
  }

  .notice-mark {
    color: var(--color-accent);
    font-size: 28px;
    line-height: 1;
  }

  .feature-section {
    margin-top: 54px;
  }

  .section-heading {
    margin-bottom: 20px;
    text-align: center;
  }

  .section-heading p {
    margin: 0 0 4px;
    color: var(--color-accent);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .section-heading h2 {
    margin: 0;
    color: #303030;
    font-size: clamp(2rem, 5vw, 3.6rem);
    font-weight: 400;
    letter-spacing: -0.05em;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }

  .feature-card {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #111;
    color: #fff;
    text-decoration: none;
  }

  .feature-card::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(4, 8, 14, 0.72),
      rgba(4, 8, 14, 0.12),
      rgba(4, 8, 14, 0.62)
    );
    content: "";
    opacity: 0.78;
    transition: opacity 0.25s ease;
  }

  .feature-card:is(:hover, :focus-visible)::after {
    opacity: 0.94;
  }

  .feature-card :global(img) {
    width: 100%;
    height: 100%;
    border-radius: 0;
    object-fit: cover;
    transition: transform 0.55s ease;
  }

  .feature-card:is(:hover, :focus-visible) :global(img) {
    transform: scale(1.08);
  }

  .feature-label,
  .feature-title {
    position: absolute;
    z-index: 2;
  }

  .feature-label {
    top: 16px;
    left: 16px;
    color: rgba(255, 255, 255, 0.68);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .feature-title {
    right: 18px;
    bottom: 18px;
    left: 18px;
    transform: translateY(34px);
    transition: transform 0.28s ease;
  }

  .feature-card:is(:hover, :focus-visible) .feature-title {
    transform: translateY(0);
  }

  .feature-title strong,
  .feature-title small {
    display: block;
  }

  .feature-title strong {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 18px;
    font-weight: 500;
  }

  .feature-title small {
    display: -webkit-box;
    overflow: hidden;
    margin-top: 8px;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    color: rgba(255, 255, 255, 0.72);
    font-size: 12px;
    line-height: 1.5;
  }

  @media (prefers-reduced-motion: reduce) {
    .home-content,
    .feature-card :global(img),
    .feature-title {
      transition: none;
    }
  }

  @media (max-width: 860px) {
    .notice,
    .feature-section {
      width: min(100% - 28px, var(--width-prose));
    }

    .feature-grid {
      grid-template-columns: 1fr;
    }

    .feature-card::after {
      opacity: 0.9;
    }

    .feature-title {
      transform: translateY(0);
    }
  }

  @media (max-width: 560px) {
    .notice {
      align-items: flex-start;
    }
  }
</style>
