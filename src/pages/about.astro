---
import { getEntry, render } from "astro:content";
import { contentComponents } from "../content-components";
import ProsePageLayout from "../layouts/ProsePageLayout.astro";

const about = await getEntry("about", "about");

if (!about) {
  throw new Error(
    "Missing required content entry: pages/about.md in BLOG_CONTENT_DIR",
  );
}

const { Content } = await render(about);
---

<ProsePageLayout {...about.data}>
  <Content components={contentComponents} />
</ProsePageLayout>
