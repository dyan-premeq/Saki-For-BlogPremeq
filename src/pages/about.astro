---
import { getEntry, render } from 'astro:content';
import AboutPage from '../layouts/AboutPage.astro';

const about = await getEntry('about', 'about');

if (!about) {
	throw new Error('Missing required content entry: pages/about.md in BLOG_CONTENT_DIR');
}

const { Content } = await render(about);
---

<AboutPage {...about.data}>
	<Content />
</AboutPage>
